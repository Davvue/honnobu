FORMAT_FILES=$(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g')
if [ -n "$FORMAT_FILES" ]; then
  pnpm format $FORMAT_FILES --ignore-unknown
fi

API_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- apps/api/ | sed 's|^apps/api/||' | sed 's| |\\ |g')
if [ -n "$API_FILES" ]; then
  pnpm --filter api lint $API_FILES
fi
pnpm --filter api test

WEB_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- apps/web/ | sed 's|^apps/web/||' | sed 's| |\\ |g')
if [ -n "$WEB_FILES" ]; then
  pnpm --filter web lint $WEB_FILES
fi
pnpm --filter web test:ci

git update-index --again